    "Buvez régulièrement de l'eau, sans attendre d'avoir soif. En travaillant dehors : au moins un verre d'eau toutes les 15 à 20 minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trink regelmäßig Wasser, ohne auf Durst zu warten. Bei Arbeit im Freien: mindestens ein Glas Wasser alle 15 bis 20 Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drink water regularly, without waiting until you're thirsty. When working outdoors: at least one glass of water every 15 to 20 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bebe agua con regularidad, sin esperar a tener sed. Si trabajas al aire libre: al menos un vaso de agua cada 15 a 20 minutos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beba água regularmente, sem esperar ter sede. Ao trabalhar ao ar livre: pelo menos um copo de água a cada 15 a 20 minutos."
          }
        }
      }
    },
