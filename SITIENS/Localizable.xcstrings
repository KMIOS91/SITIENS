    "L'effort fait perdre de 0,5 à 2,5 litres d'eau par heure. Buvez dès le début de l'exercice, sans attendre la soif." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei körperlicher Anstrengung verliert man 0,5 bis 2,5 Liter Wasser pro Stunde. Trink schon ab Beginn der Übung, ohne auf Durst zu warten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exercise makes you lose 0.5 to 2.5 litres of water per hour. Drink from the start of exercise, without waiting until you're thirsty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esfuerzo hace perder de 0,5 a 2,5 litros de agua por hora. Bebe desde el inicio del ejercicio, sin esperar a tener sed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O esforço faz perder de 0,5 a 2,5 litros de água por hora. Beba desde o início do exercício, sem esperar ter sede."
          }
        }
      }
    },
